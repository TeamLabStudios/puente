{
  "name": "puente",
  "productName": "Puente",
  "version": "0.3.0",
  "description": "Pasa archivos entre tus PC con Windows y tu móvil Android, en casa o fuera, cifrados de punta a punta (Noise XX + AES-256-GCM). Sin nube.",
  "author": "TeamLabStudios",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "test": "node --test --test-timeout=120000 tests/*.test.cjs",
    "predist": "bash scripts/verificar.sh",
    "dist": "vite build && electron-builder --win nsis",
    "relay": "node electron/relay-server.cjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "com.david.puente",
    "productName": "Puente",
    "copyright": "TeamLabStudios",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Puente",
      "artifactName": "Puente-${version}-instalador.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TeamLabStudios/puente.git"
  },
  "homepage": "https://github.com/TeamLabStudios/puente",
  "bugs": {
    "url": "https://github.com/TeamLabStudios/puente/issues"
  },
  "keywords": [
    "file-transfer",
    "file-sharing",
    "end-to-end-encryption",
    "noise-protocol",
    "x25519",
    "aes-gcm",
    "electron",
    "android",
    "privacy",
    "self-hosted",
    "localsend-alternative",
    "airdrop-alternative"
  ]
}
